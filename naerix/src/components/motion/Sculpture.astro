---
import { createSculptureFaces } from '../../lib/sculpture';
const faces = createSculptureFaces();
---

<div class="sculpture" data-sculpture>
  <div class="art-frame" aria-hidden="true">
    <span class="registration registration--tl"></span>
    <span class="registration registration--tr"></span>
    <span class="registration registration--bl"></span>
    <span class="registration registration--br"></span>
    <svg id="sculpture-object" class="sculpture-object" viewBox="0 0 640 660" fill="none">
      <defs>
        <radialGradient id="ground">
          <stop stop-color="#000" stop-opacity=".8" />
          <stop offset="1" stop-color="#000" stop-opacity="0" />
        </radialGradient>
      </defs>
      <ellipse cx="320" cy="593" rx="250" ry="38" fill="url(#ground)" />
      <g>
        {faces.map((f) => (
          <polygon points={f.points} fill={f.color} stroke={f.color} stroke-width=".45" />
        ))}
      </g>
    </svg>
  </div>
  <div class="art-caption">
    <span class="eyebrow">Many perspectives. One direction.</span>
    <button type="button" class="motion-button eyebrow" aria-controls="sculpture-object" hidden>
      <span class="motion-symbol" aria-hidden="true">
        Ⅱ
      </span>
      <span data-motion-label>Pause motion</span>
    </button>
  </div>
</div>
<style>
  .sculpture {
    width: 100%;
  }
  .art-frame {
    position: relative;
    padding: 8px;
  }
  .sculpture-object {
    width: 100%;
  }
  .registration {
    position: absolute;
    width: 12px;
    height: 12px;
    opacity: 0.7;
  }
  .registration--tl {
    left: 2%;
    top: 10%;
    border-top: 1px solid var(--rule-strong);
    border-left: 1px solid var(--rule-strong);
  }
  .registration--tr {
    right: 2%;
    top: 10%;
    border-top: 1px solid var(--rule-strong);
    border-right: 1px solid var(--rule-strong);
  }
  .registration--bl {
    left: 2%;
    bottom: 7%;
    border-bottom: 1px solid var(--rule-strong);
    border-left: 1px solid var(--rule-strong);
  }
  .registration--br {
    right: 2%;
    bottom: 7%;
    border-bottom: 1px solid var(--rule-strong);
    border-right: 1px solid var(--rule-strong);
  }
  .art-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-inline: 2%;
    color: var(--ink-subtle);
  }
  .art-caption .eyebrow {
    font-size: 10px;
    letter-spacing: 0.075em;
  }
  .motion-button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 0 12px 8px;
    border: 0;
    background: transparent;
    min-height: 44px;
    white-space: nowrap;
  }
  .motion-button:hover {
    color: var(--ink);
  }
  .motion-symbol {
    font-size: 13px;
    width: 15px;
    text-align: center;
  }
</style>
<script>
  import { createSculptureFaces } from '../../lib/sculpture';

  const sculpture = document.querySelector<HTMLElement>('[data-sculpture]');
  const button = sculpture?.querySelector<HTMLButtonElement>('.motion-button');
  const label = sculpture?.querySelector<HTMLElement>('[data-motion-label]');
  const symbol = sculpture?.querySelector<HTMLElement>('.motion-symbol');
  if (sculpture && button && label && symbol) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const polygons = Array.from(sculpture.querySelectorAll<SVGPolygonElement>('polygon'));
    let preference: 'auto' | 'play' | 'pause' = 'auto';
    let inView = true;
    let frame: number | null = null;
    let previousTime: number | null = null;
    let angle = 0;

    const draw = (time: number) => {
      if (previousTime === null) previousTime = time;
      const elapsed = time - previousTime;
      // Cap DOM updates at 30 fps and avoid jumping after a stalled frame.
      if (elapsed >= 1000 / 30) {
        angle = (angle + (Math.min(elapsed, 100) * Math.PI * 2) / 32000) % (Math.PI * 2);
        previousTime = time;
        createSculptureFaces(angle).forEach((face, index) => {
          const polygon = polygons[index];
          polygon.setAttribute('points', face.points);
          if (polygon.getAttribute('fill') !== face.color) {
            polygon.setAttribute('fill', face.color);
            polygon.setAttribute('stroke', face.color);
          }
        });
      }
      frame = requestAnimationFrame(draw);
    };

    const sync = () => {
      const wantsMotion = preference === 'play' || (preference === 'auto' && !reduced.matches);
      const running = wantsMotion && inView && !document.hidden;
      sculpture.dataset.moving = String(wantsMotion);
      sculpture.dataset.paused = String(!running);
      button.hidden = false;
      label.textContent = wantsMotion
        ? 'Pause motion'
        : preference === 'pause'
          ? 'Resume motion'
          : 'Play motion';
      symbol.textContent = wantsMotion ? 'Ⅱ' : '▷';
      if (running && frame === null) frame = requestAnimationFrame(draw);
      if (!running && frame !== null) {
        cancelAnimationFrame(frame);
        frame = null;
        previousTime = null;
      }
    };
    button.addEventListener('click', () => {
      preference = sculpture.dataset.moving === 'true' ? 'pause' : 'play';
      sync();
    });
    reduced.addEventListener('change', () => {
      // A newly enabled OS preference takes effect even after an earlier manual play.
      if (preference !== 'pause') preference = 'auto';
      sync();
    });
    document.addEventListener('visibilitychange', sync);
    window.addEventListener('pagehide', () => {
      if (frame !== null) cancelAnimationFrame(frame);
      frame = null;
      previousTime = null;
    });
    window.addEventListener('pageshow', sync);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        sync();
      }).observe(sculpture);
    }
    sync();
  }
</script>
