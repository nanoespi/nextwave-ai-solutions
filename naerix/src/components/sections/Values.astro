---
interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
const values = [
  {
    title: 'Craftsmanship.',
    description:
      'Care in the thinking. Precision in the making. We believe the details are where good work earns its value.',
  },
  {
    title: 'Expertise first.',
    description:
      'The people who know an industry should help shape what comes next. We build with their judgment at the center.',
  },
  {
    title: 'Technology with purpose.',
    description:
      'We put new capabilities to work on real problems, choosing tools for the difference they can make.',
  },
];
---

<section
  id="values"
  class:list={['values shell', { 'values--full': full }]}
  aria-labelledby="values-title"
  tabindex="-1"
>
  <div class="values-intro">
    <p class="section-label eyebrow">
      <span class="index">03 /</span> What we stand for
    </p>
    <h2 class="section-heading" id="values-title">
      Our common
      <br />
      ground.
    </h2>
  </div>
  <div class="values-list">
    {values.map((value, index) => (
      <article>
        <span class="eyebrow">0{index + 1}</span>
        <div>
          <h3>{value.title}</h3>
          <p>{value.description}</p>
        </div>
        <span class="value-mark" aria-hidden="true">
          +
        </span>
      </article>
    ))}
  </div>
</section>
<style>
  .values {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 80px;
    padding-block: 110px;
  }
  .values-intro h2 {
    margin-top: 40px;
  }
  .values-list article {
    display: flex;
    align-items: flex-start;
    gap: 28px;
    padding: 32px 0;
    border-top: 1px solid var(--rule);
  }
  .values-list article:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .values-list article > .eyebrow {
    color: var(--ink-subtle);
    font-size: 10px;
    padding-top: 7px;
  }
  h3 {
    font-size: 24px;
    letter-spacing: -0.04em;
  }
  article p {
    font-size: 13px;
    line-height: 1.9;
    color: var(--ink-muted);
    margin-top: 13px;
    max-width: 350px;
  }
  .value-mark {
    margin-left: auto;
    font-size: 17px;
    color: var(--ink-subtle);
    font-weight: 300;
  }
  @media (max-width: 740px) {
    .values {
      grid-template-columns: 1fr;
      gap: 38px;
      padding-block: 66px;
    }
    .values-intro h2 {
      margin-top: 30px;
    }
    .values-list article {
      gap: 22px;
    }
  }
</style>
